# Copy this file to .env for local development. Never commit real .env.
PORT=5000
DATABASE_PATH=./data/texcellence.sqlite

# Admin authentication (Chunk 5). Set real values in your local .env only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# RSVP email (Chunk 8). Set real values in your local .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@texcellence.example
# Public site URL used to build the registration link in emails.
PUBLIC_APP_URL=http://localhost:5173
